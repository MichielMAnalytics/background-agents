# Configuration for the control plane running as a Node process. Copy to
# `.env` and fill it in; `.env` is gitignored. The host reads its process
# environment, so any loader works:
#   node --env-file=.env packages/control-plane/dist/node/main.js
# The compose stack (docker-compose.yml) reads it as the app's env_file.
#
# The deployment variables have the same names and meanings on Cloudflare,
# where they are Worker variables and secrets. Each line names its source
# there: a Cloudflare deploy setting (the uppercase name in
# scripts/cloudflare-deploy/deploy.env.example, which the deploy binds to the
# Worker), a value the deploy computes (local.…), a value Terraform generates
# and the deploy reads from the GitHub Environment (random_password.…), or "not
# set by the deploy". `wrangler deploy` replaces every Worker variable with the
# ones the deploy defines, so a value marked "not set by the deploy" that is
# added in the Cloudflare dashboard is removed by the next deploy. The Node-only
# settings at the top have no Cloudflare counterpart. An empty value counts as
# unset.
#
# On AWS the container's environment is materialized from SSM Parameter Store
# by the deploy step; nothing in this file is baked into the image.
#
# `packages/control-plane/src/node/env-example.test.ts` checks that this file
# names every variable the host reads and nothing else, and that the keys the
# host requires at boot are exactly the ones marked "Required.".

# ---------------------------------------------------------------------------
# Node host (no Cloudflare equivalent: the platform provides these there)
# ---------------------------------------------------------------------------

# Interface and port to listen on. 8787 matches the Worker's local dev port.
HOST=0.0.0.0
PORT=8787
# Directory holding the global store (global.db), the per-session files
# (sessions/<id>.db) and the host alarm index. A volume in the container.
DATA_DIR=/data
# The D1 migration files, applied to the global store at boot. The image sets
# this to its own copy; leave empty to use terraform/d1/migrations from a
# repository checkout.
MIGRATIONS_DIR=
# How long a shutdown waits for in-flight work before the process is forced
# down. The compose stack pins this together with its stop grace period.
SHUTDOWN_TIMEOUT_MS=30000

# ---------------------------------------------------------------------------
# Object storage for media (Cloudflare: the MEDIA_BUCKET R2 binding)
# ---------------------------------------------------------------------------

# Any S3-compatible bucket. The compose stack points these at its object store.
OBJECT_STORE_BUCKET=media
OBJECT_STORE_REGION=us-east-1
# Leave empty for AWS S3. Other S3-compatible services need it.
OBJECT_STORE_ENDPOINT=http://object-store:9000
# Plain-http endpoints are refused unless this is "true" (local object store only).
OBJECT_STORE_ALLOW_HTTP=true
# "true" for the local object store (bucket in the path, not the hostname).
OBJECT_STORE_FORCE_PATH_STYLE=true
# Credentials through the AWS SDK's default chain. Leave both empty on EC2 to
# use the instance role. For the compose stack they are the object store's
# root user and password (OBJECT_STORE_ROOT_USER / OBJECT_STORE_ROOT_PASSWORD
# below).
AWS_ACCESS_KEY_ID=objectstoreadmin
AWS_SECRET_ACCESS_KEY=
# Only with temporary (STS) credentials; empty for static keys or a role.
AWS_SESSION_TOKEN=

# ---------------------------------------------------------------------------
# Deployment identity (Cloudflare: deploy settings)
# ---------------------------------------------------------------------------

# Required. Cloudflare: DEPLOYMENT_NAME
DEPLOYMENT_NAME=local
# Display name in the UI, PR footers and User-Agent headers. Cloudflare: APP_NAME
APP_NAME=Open-Inspect
# Required. The GitHub App's bot login, `<app-slug>[bot]`. Only used to attribute
# and filter the bot's own activity, so the placeholder below boots a local or
# staging stack; set it to the real login before connecting a GitHub App.
# Cloudflare: GH_BOT_USERNAME
GITHUB_BOT_USERNAME=open-inspect[bot]
# Public base URL of this control plane; sandboxes and image builds call back
# to it, so it must be reachable from the sandbox provider. Cloudflare: local.control_plane_url
WORKER_URL=http://localhost:8787
# Base URL of the web app, for PR links and browser-auth origin checks. Cloudflare: local.web_app_url
WEB_APP_URL=http://localhost:3000
# "github" (default) or "gitlab". Cloudflare: not set by the deploy.
SCM_PROVIDER=github
# Cloudflare account id; only used to derive a workers.dev callback URL when
# WORKER_URL is unset. Cloudflare: not set by the deploy.
CF_ACCOUNT_ID=

# ---------------------------------------------------------------------------
# Encryption keys (Cloudflare: secret). Each is 32 random bytes, base64:
#   openssl rand -base64 32
# A key that is not 32 bytes is rejected (the token and repo-secrets keys at
# boot, the provider-accounts key at first use). Rotating one invalidates what
# it encrypted, so generate them once per deployment and keep them.
# ---------------------------------------------------------------------------

# Required. OAuth tokens at rest. Cloudflare: TOKEN_ENCRYPTION_KEY
TOKEN_ENCRYPTION_KEY=
# Required. Model-provider account credentials. Cloudflare: PROVIDER_ACCOUNTS_ENCRYPTION_KEY (Terraform generates it unless supplied)
PROVIDER_ACCOUNTS_ENCRYPTION_KEY=
# Required. Repo-scoped secrets and MCP server configuration. Cloudflare: REPO_SECRETS_ENCRYPTION_KEY
REPO_SECRETS_ENCRYPTION_KEY=
# Pepper for image-build callback token hashes. Cloudflare: generated by Terraform (random_password.image_callback_token_pepper), deploy setting IMAGE_CALLBACK_TOKEN_PEPPER
IMAGE_CALLBACK_TOKEN_PEPPER=

# ---------------------------------------------------------------------------
# Browser sign-in, new bot-account admission, and access control
# ---------------------------------------------------------------------------

# Signs Better Auth state. Cloudflare: secret, NEXTAUTH_SECRET
BROWSER_AUTH_SECRET=
# GitHub OAuth app for sign-in. Cloudflare: var / secret, GH_OAUTH_CLIENT_ID / GH_OAUTH_CLIENT_SECRET
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Google OAuth app for sign-in (optional). Cloudflare: var / secret, GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Deployment baseline: comma-separated rules, additive (OR) with SQL-managed
# Settings > Workspace access > Who can sign in rules. The UI cannot narrow
# this baseline; changing these values does not remove SQL-managed grants.
# Keep a compatible baseline for every enabled provider; SQL rules cannot rescue
# an empty/incompatible baseline. Prefer a verified recovery admin email.
# Cloudflare: ALLOWED_USERS, ALLOWED_EMAIL_DOMAINS, ALLOWED_EMAILS,
# ALLOWED_GITHUB_ORGS. See docs/AUTH.md for rollout and rollback.
# Fresh Slack/Linear accounts use the effective email/domain union with attested
# email. Known actors and attested-email links to existing accounts do not repeat
# admission; their role/suspension and bot invocation restrictions still apply.
# GitHub bot profile emails are not verified evidence; GitHub bot actors must be
# known or unsafe allow-all must be effective. Username/org rules cannot enroll them.
# GitHub usernames only (not canonical user IDs).
ALLOWED_USERS=
# Exact verified email domains, including neither wildcards nor subdomains.
ALLOWED_EMAIL_DOMAINS=
# Exact verified emails, supported by GitHub and Google sign-in.
ALLOWED_EMAILS=
# Active GitHub org membership; uses App permissions, adds no OAuth scopes/read:org.
ALLOWED_GITHUB_ORGS=
# "true" allows any otherwise valid identity ONLY when all effective deployment
# AND managed lists are empty. Nonempty rules still apply. The settings editor
# is read-only whenever this flag is true, even if allow-all is dormant.
# New Slack/Linear actors still require attested email, even in unsafe mode.
# Cloudflare: UNSAFE_ALLOW_ALL_USERS. Prefer false plus a recovery baseline.
UNSAFE_ALLOW_ALL_USERS=
# Managed limits: 50 total rules, 10 organizations, 64-KiB requests; deployment
# rules stay separate.

# ---------------------------------------------------------------------------
# Service-to-service authentication (Cloudflare: secret, generated by
# Terraform as random_password.service_auth_secret_*; the deploy reads them as
# the SERVICE_AUTH_SECRET_* settings). Each service signs its
# requests with its own secret; an unset secret means that service cannot
# authenticate. The web app's SERVICE_AUTH_SECRET must equal SERVICE_AUTH_SECRET_WEB.
# ---------------------------------------------------------------------------

SERVICE_AUTH_SECRET_WEB=
SERVICE_AUTH_SECRET_SLACK_BOT=
SERVICE_AUTH_SECRET_GITHUB_BOT=
SERVICE_AUTH_SECRET_LINEAR_BOT=
# Bot token for agent-initiated Slack messages (optional). Cloudflare: secret, SLACK_BOT_TOKEN
SLACK_BOT_TOKEN=

# ---------------------------------------------------------------------------
# Source control (Cloudflare: secret)
# ---------------------------------------------------------------------------

# GitHub App credentials for repository access and git operations. The private
# key is the PEM text (PKCS#8) on one line, either double-quoted with real
# newlines (compose decodes "\n" inside double quotes) or with the two
# characters \n in place of each newline, which the key parser strips.
# Cloudflare: GH_APP_ID, GH_APP_PRIVATE_KEY, GH_APP_INSTALLATION_ID
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
# Optional second GitHub App whose installation token submits code reviews, so a
# review of a pull request the main App opened can approve rather than only
# comment. Needs Pull requests: Read & write and nothing else. Set all three
# together with GITHUB_REVIEWER_USERNAME on the github-bot, or leave all four
# unset. Cloudflare: GH_REVIEWER_APP_ID,
# GH_REVIEWER_APP_PRIVATE_KEY, GH_REVIEWER_APP_INSTALLATION_ID
GITHUB_REVIEWER_APP_ID=
GITHUB_REVIEWER_APP_PRIVATE_KEY=
GITHUB_REVIEWER_APP_INSTALLATION_ID=
# GitLab, when SCM_PROVIDER=gitlab. Cloudflare: not set by the deploy.
GITLAB_ACCESS_TOKEN=
GITLAB_NAMESPACE=

# ---------------------------------------------------------------------------
# Sandbox provider. One of "modal" (default), "modal-vm", "daytona", "vercel",
# "e2b", "boat"; only that provider's block needs values.
# Cloudflare: SANDBOX_PROVIDER
# ---------------------------------------------------------------------------

SANDBOX_PROVIDER=modal
# Set modal-vm for deployment-wide Docker-capable VMs; see docs/MODAL_DOCKER.md.

# Modal. The API secret is shared with the Modal deployment for HMAC-signed
# endpoint calls; the workspace and environment build the endpoint URLs.
# Cloudflare: secret MODAL_API_SECRET; MODAL_WORKSPACE,
# MODAL_ENVIRONMENT, MODAL_ENVIRONMENT_WEB_SUFFIX
MODAL_API_SECRET=
MODAL_WORKSPACE=
MODAL_ENVIRONMENT=
MODAL_ENVIRONMENT_WEB_SUFFIX=
# Origin serving the Modal functions by path (`<origin>/api-create-sandbox`), in
# place of their derived `*.modal.run` hosts. Leave empty against Modal itself;
# a proxy or the compose smoke's stand-in server sets it.
# Cloudflare: not set by the deploy
MODAL_API_URL=
# Modal API tokens; not read by the control plane today (the Modal app is
# deployed with them separately). Cloudflare: not set by the deploy.
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=

# Daytona. Cloudflare: secret DAYTONA_API_KEY; DAYTONA_API_URL,
# DAYTONA_BASE_SNAPSHOT, DAYTONA_TARGET, DAYTONA_TOOLBOX_API_URL,
# DAYTONA_PREBUILDS_ENABLED. The two interval settings are not set by
# the deploy.
#
# DAYTONA_TOOLBOX_API_URL overrides the per-sandbox toolbox proxy; leave it
# empty on a deployment whose sandboxes report their own.
#
# DAYTONA_PREBUILDS_ENABLED ("true"/"1") admits new Daytona image builds and
# lets fresh sessions boot from one. Default off: callbacks, finalization,
# status and cleanup keep working while it is, so closing it is the rollback.
DAYTONA_API_KEY=
DAYTONA_API_URL=
DAYTONA_BASE_SNAPSHOT=
DAYTONA_TARGET=
DAYTONA_TOOLBOX_API_URL=
DAYTONA_PREBUILDS_ENABLED=
DAYTONA_AUTO_STOP_INTERVAL_MINUTES=
DAYTONA_AUTO_ARCHIVE_INTERVAL_MINUTES=

# Vercel Sandboxes. Cloudflare: secret VERCEL_SANDBOX_TOKEN;
# VERCEL_SANDBOX_PROJECT_ID, VERCEL_SANDBOX_TEAM_ID,
# VERCEL_BASE_SNAPSHOT_ID, VERCEL_SANDBOX_RUNTIME,
# VERCEL_SANDBOX_API_BASE_URL, VERCEL_SNAPSHOT_EXPIRATION_MS.
# VERCEL_BASE_SNAPSHOT_NAME is generated (module.vercel_sandbox_infra[0].snapshot_name)
# when no snapshot id is supplied.
VERCEL_TOKEN=
VERCEL_PROJECT_ID=
VERCEL_TEAM_ID=
VERCEL_BASE_SNAPSHOT_ID=
VERCEL_BASE_SNAPSHOT_NAME=
VERCEL_RUNTIME=
VERCEL_SANDBOX_API_BASE_URL=
VERCEL_SNAPSHOT_EXPIRATION_MS=

# E2B. Cloudflare: secret E2B_API_KEY; E2B_API_URL,
# E2B_TEMPLATE_ID, E2B_SANDBOX_TIMEOUT_SECONDS, E2B_AUTO_PAUSE
E2B_API_KEY=
E2B_API_URL=
E2B_TEMPLATE_ID=
E2B_SANDBOX_TIMEOUT_SECONDS=
E2B_AUTO_PAUSE=

# Boat. Cloudflare: secret BOAT_API_KEY; BOAT_API_URL,
# BOAT_BASE_SNAPSHOT (the saved snapshot the boat-infra module builds),
# BOAT_ORG, BOAT_SANDBOX_TYPE.
#
# BOAT_SANDBOX_TYPE is the machine size (small, default, large, xlarge) for
# sessions that request no CPU or memory; a request picks the smallest size
# that fits it. When sandboxes bill an organization (BOAT_ORG, or the account's
# active wallet), set the organization's default visibility to private; the
# provider unshares any sandbox that still starts shared.
BOAT_API_KEY=
BOAT_API_URL=
BOAT_BASE_SNAPSHOT=
BOAT_ORG=
BOAT_SANDBOX_TYPE=

# EC2 (Node host only; see docs/EC2_SANDBOX_PROVIDER.md). One instance per
# session in this AWS account, controlled with the host's instance role.
# EC2_SANDBOX_AMI_ID is the base AMI packages/ec2-infra builds;
# EC2_SANDBOX_INSTANCE_TYPE overrides the provider's default instance type.
# The aws-control-plane Terraform module sets all of these, and
# SANDBOX_PROVIDER=ec2, once EC2_SANDBOXES names an AMI.
EC2_SANDBOX_REGION=
EC2_SANDBOX_AMI_ID=
EC2_SANDBOX_INSTANCE_TYPE=
EC2_SANDBOX_SUBNET_ID=
EC2_SANDBOX_SECURITY_GROUP_ID=
EC2_SANDBOX_INSTANCE_PROFILE_ARN=
EC2_SANDBOX_CONTROL_PLANE_PRIVATE_HOST=

# ---------------------------------------------------------------------------
# Sandbox lifecycle (Cloudflare: deploy settings)
# ---------------------------------------------------------------------------

# A connected session-page WebSocket extends idle timers; direct terminal,
# VS Code, or VNC connections alone do not.
# Regular idle timeout, in ms (default 600000), for user, slack-bot, and linear-bot sessions.
# Cloudflare: SANDBOX_INACTIVITY_TIMEOUT_MS
SANDBOX_INACTIVITY_TIMEOUT_MS=
# Idle timeout for automation, github-bot, and agent sessions, in ms (default 120000,
# minimum 60000; lower values are rejected). Effective timeout is min(this, regular).
# Set at or above SANDBOX_INACTIVITY_TIMEOUT_MS to disable the shorter timeout.
# Cloudflare: SANDBOX_UNATTENDED_INACTIVITY_TIMEOUT_MS
SANDBOX_UNATTENDED_INACTIVITY_TIMEOUT_MS=
# Longest a sandbox whose bridge has connected may keep booting (clone,
# setup.sh, start.sh, agent start) before it is failed and the prompt it was
# for fails, in ms (default 1800000). Cloudflare: SANDBOX_BOOT_TIMEOUT_MS
SANDBOX_BOOT_TIMEOUT_MS=
# Longest a turn may run before it is failed, in ms; also the budget the
# automation recovery sweep holds a run to. A session without its own sandbox
# timeout setting falls back to the sandbox timeout (7200000). Cloudflare: not
# set by the deploy.
EXECUTION_TIMEOUT_MS=
# "enforce" (default) fails spawn and build on oversized secret payloads;
# "warn" only logs. Cloudflare: not set by the deploy.
SECRETS_CAP_ENFORCEMENT=
# Session team enforcement: off, shadow, or on. Unset defaults to shadow.
# Private visibility applies in every mode. Cloudflare: TEAMS_ENFORCEMENT.
TEAMS_ENFORCEMENT=

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# "debug" | "info" | "warn" | "error" (default "info"). Cloudflare: not set by the deploy.
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Compose stack only (docker-compose.yml). Not read by the control plane.
# ---------------------------------------------------------------------------

# Host interface the app's port is published on. Loopback keeps the plaintext
# listener local; Caddy (the "tls" profile) reaches the app over the compose
# network. Use 0.0.0.0 only where a firewall or security group fronts the
# host, such as behind the AWS load balancer. The object store's S3 port is
# published on loopback only.
APP_BIND_ADDRESS=127.0.0.1
# Root credentials for the compose stack's object store. The password is
# required and has no default:
#   openssl rand -hex 16
# The AWS_* and LITESTREAM_* credentials are these same values when the
# stack's own object store is in use.
OBJECT_STORE_ROOT_USER=objectstoreadmin
OBJECT_STORE_ROOT_PASSWORD=
# Where Litestream replicates DATA_DIR/global.db, read by the sidecar and by
# the app image's restore-on-empty entrypoint. The compose stack requires a
# bucket name; only the image run on its own treats an empty value as "no
# replica". LITESTREAM_ENDPOINT is empty for AWS S3.
LITESTREAM_BUCKET=backups
LITESTREAM_ENDPOINT=http://object-store:9000
LITESTREAM_ACCESS_KEY_ID=objectstoreadmin
LITESTREAM_SECRET_ACCESS_KEY=
# Hostname Caddy obtains a certificate for under the "tls" profile.
CADDY_DOMAIN=
